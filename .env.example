# LLM Configuration
# Options: mock | gemini | openai | anthropic | ollama
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
MOCK_LLM=true

# API Keys (leave blank if MOCK_LLM=true)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama local URL
OLLAMA_BASE_URL=http://localhost:11434

# Data & Database configuration
DB_PATH=data/energy.duckdb

# Server ports
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501

# Factory & Environmental parameters
EMISSION_FACTOR_KG_PER_KWH=0.4
